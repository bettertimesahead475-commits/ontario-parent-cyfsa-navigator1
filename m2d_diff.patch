+    expect(sql).toContain("elsif TG_TABLE_NAME = 'navigator_claim_relationships' then");
+  });
+
+  it("enables RLS on new tables", () => {
+    expect(sql).toContain("alter table public.navigator_claim_relationships enable row level security;");
+  });
+});

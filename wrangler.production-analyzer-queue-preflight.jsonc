{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyfsa-production-analyzer-queue-consumer",
  "main": "workers/analyzer-queue-consumer.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true }
  },
  "vars": {
    "ANALYZER_ENABLED": "false",
    "FIREBASE_PROJECT_ID": "gen-lang-client-0105737183",
    "STAGING_SUPABASE_URL": "https://nxfhvebzzobegubefcda.supabase.co/",
    "ANALYZER_JOBS_QUEUE_NAME": "cyfsa-analyzer-jobs",
    "ANALYZER_JOBS_DLQ_NAME": "cyfsa-analyzer-dead-letter"
  },
  "queues": {
    "producers": [
      {
        "binding": "ANALYZER_JOBS_REQUEUE",
        "queue": "cyfsa-analyzer-jobs"
      }
    ]
  }
}

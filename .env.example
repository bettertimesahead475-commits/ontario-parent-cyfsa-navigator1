# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Required for Claude AI API calls.
# AI Studio matches and populates this from user secrets.
ANTHROPIC_API_KEY="YOUR_CLAUDE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project
SUPABASE_URL=

# SUPABASE_SERVICE_KEY: The service_role secret key for your Supabase database
SUPABASE_SERVICE_KEY=

# SUPABASE_SERVICE_ROLE_KEY: alternate accepted name for the same key above —
# either name works, this one is checked first (see api/services/access.ts).
SUPABASE_SERVICE_ROLE_KEY=

# ADMIN_SECRET: required for POST /api/admin/approve-payment (sent as the
# x-admin-secret header). Also used as the fallback signing secret for
# session tokens if SESSION_SECRET below isn't set.
ADMIN_SECRET=

# SESSION_SECRET: signs the access-code session tokens issued by
# /api/activate-code. Optional — falls back to ADMIN_SECRET if unset.
SESSION_SECRET=

# --- Lawyer intake email (all optional; without these, requests are still
# logged server-side, they just aren't emailed) -----------------------------
# LAWYER_INTAKE_TO: destination address for new lawyer-intake inquiries.
LAWYER_INTAKE_TO=
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS: your outgoing mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE: set to "true" for a TLS connection (usually only if using
# port 465 instead of 587).
SMTP_SECURE=false
# SMTP_FROM: optional — defaults to SMTP_USER if unset.
SMTP_FROM=

# --- Marketing Agent (admin-only social content pipeline) --------------------
# See docs/MARKETING_AGENT.md for the full setup guide. NONE of these are
# required for the app to run — every social adapter honestly reports
# "waiting_for_credentials" until its vars are set, and the admin console works
# (draft/approve/schedule) without any of them. The scheduler cron reuses
# CRON_SECRET (below). No social secret is ever stored in the database.
#
# CRON_SECRET: used by Vercel Cron to call /api/admin/check-payments AND
# /api/admin/marketing/run-scheduler. Vercel sets Authorization: Bearer <this>.
CRON_SECRET=
# ADMIN_ALERT_EMAIL: optional — where agent alerts go (falls back to the
# donations address). Shared with the Gmail payment agent.
ADMIN_ALERT_EMAIL=

# Facebook Page — needs a Page ID and a long-lived Page access token with
# pages_manage_posts + pages_read_engagement (requires Facebook App Review).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram (Business/Creator account linked to the Facebook Page) — content
# publishing requires App Review. Instagram posts are media-only.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn (organization/Company Page) — needs a token with
# w_organization_social and the organization URN, e.g. urn:li:organization:12345
# (requires LinkedIn Marketing Developer Platform approval).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=

# X (Twitter) — a USER-CONTEXT OAuth 2.0 access token with tweet.write +
# users.read (an app-only bearer token CANNOT post). Posting may require a paid
# API tier.
X_USER_ACCESS_TOKEN=

# TikTok — a user access token with video.publish. The Content Posting API
# requires app audit/approval before real public posts are accepted.
TIKTOK_ACCESS_TOKEN=



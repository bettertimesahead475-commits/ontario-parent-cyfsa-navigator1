# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Required for Claude AI API calls.
# AI Studio matches and populates this from user secrets.
ANTHROPIC_API_KEY="YOUR_CLAUDE_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project
SUPABASE_URL=

# SUPABASE_SERVICE_KEY: The service_role secret key for your Supabase database
SUPABASE_SERVICE_KEY=

# SUPABASE_SERVICE_ROLE_KEY: alternate accepted name for the same key above —
# either name works, this one is checked first (see api/services/access.ts).
SUPABASE_SERVICE_ROLE_KEY=

# FIREBASE_SERVICE_ACCOUNT_JSON: required for Firebase ID token verification
# (see api/services/firebaseAdmin.ts) — this is what lets the server trust
# who a signed-in parent actually is, e.g. for the free-tier analysis count.
# Generate a service account key in Firebase Console -> Project Settings ->
# Service Accounts -> Generate New Private Key, then paste the entire
# downloaded JSON file's contents as one single-line string here.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"YOUR_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n","client_email":"YOUR_SERVICE_ACCOUNT@YOUR_PROJECT_ID.iam.gserviceaccount.com","client_id":"YOUR_CLIENT_ID","token_uri":"https://oauth2.googleapis.com/token"}'

# ADMIN_SECRET: required for POST /api/admin/approve-payment (sent as the
# x-admin-secret header). This is a separate trust domain from SESSION_SECRET
# below — it is never used to sign or verify paid-session tokens.
ADMIN_SECRET=

# SESSION_SECRET: required. Signs and verifies the paid-session tokens issued
# by /api/activate-code (see api/services/access.ts's getSessionSecret()).
# Must be its own independently configured secret, separate from
# ADMIN_SECRET — there is no fallback. If unset, paid-session issuance and
# verification fail closed rather than falling back to another secret.
SESSION_SECRET=

# CRON_SECRET: allows Vercel Cron to call GET /api/admin/check-payments
# (as `Authorization: Bearer <CRON_SECRET>`) without the admin-secret header.
# Set this to match the value Vercel's Cron feature is configured to send.
CRON_SECRET=

# ALLOWED_ORIGINS: comma-separated list of additional origins allowed by CORS,
# beyond the built-in production defaults (https://cyfsanavigator.com and
# https://www.cyfsanavigator.com). Use this for a staging/preview domain.
ALLOWED_ORIGINS=

# --- Gmail payment-detection agent (all required together for the automated
# e-transfer scanning agent; without them, payments must be approved manually
# via POST /api/admin/approve-payment) --------------------------------------
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI: from an OAuth
# 2.0 Client ID (Web application) in Google Cloud Console, with the Gmail API
# enabled. GOOGLE_REDIRECT_URI must exactly match the one registered on that
# client and point at GET /api/admin/gmail-callback on this deployment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# GMAIL_REFRESH_TOKEN: obtained once via the GET /api/admin/gmail-auth-url ->
# GET /api/admin/gmail-callback flow (see api/services/gmailAgent.ts).
GMAIL_REFRESH_TOKEN=
# ADMIN_ALERT_EMAIL: where the Gmail agent sends match/error/stale-payment
# alerts. Optional — defaults to the payment-receiving inbox itself if unset.
ADMIN_ALERT_EMAIL=

# --- Lawyer intake email (all optional; without these, requests are still
# logged server-side, they just aren't emailed) -----------------------------
# LAWYER_INTAKE_TO: destination address for new lawyer-intake inquiries.
LAWYER_INTAKE_TO=
# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS: your outgoing mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE: set to "true" for a TLS connection (usually only if using
# port 465 instead of 587).
SMTP_SECURE=false
# SMTP_FROM: optional — defaults to SMTP_USER if unset.
SMTP_FROM=

# --- Marketing Agent (admin-only social content pipeline) --------------------
# See docs/MARKETING_AGENT.md for the full setup guide. NONE of these are
# required for the app to run — every social adapter honestly reports
# "waiting_for_credentials" until its vars are set, and the admin console works
# (draft/approve/schedule) without any of them. The scheduler cron reuses
# CRON_SECRET (below). No social secret is ever stored in the database.
#
# CRON_SECRET: used by Vercel Cron to call /api/admin/check-payments AND
# /api/admin/marketing/run-scheduler. Vercel sets Authorization: Bearer <this>.
CRON_SECRET=
# ADMIN_ALERT_EMAIL: optional — where agent alerts go (falls back to the
# donations address). Shared with the Gmail payment agent.
ADMIN_ALERT_EMAIL=

# Facebook Page — needs a Page ID and a long-lived Page access token with
# pages_manage_posts + pages_read_engagement (requires Facebook App Review).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram (Business/Creator account linked to the Facebook Page) — content
# publishing requires App Review. Instagram posts are media-only.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn (organization/Company Page) — needs a token with
# w_organization_social and the organization URN, e.g. urn:li:organization:12345
# (requires LinkedIn Marketing Developer Platform approval).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=

# X (Twitter) — a USER-CONTEXT OAuth 2.0 access token with tweet.write +
# users.read (an app-only bearer token CANNOT post). Posting may require a paid
# API tier.
X_USER_ACCESS_TOKEN=

# TikTok — a user access token with video.publish. The Content Posting API
# requires app audit/approval before real public posts are accepted.
TIKTOK_ACCESS_TOKEN=
